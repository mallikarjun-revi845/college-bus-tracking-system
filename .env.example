# Backend
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/college_bus_tracking

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d

# Client
CLIENT_URL=http://localhost:5173

# Socket.IO
SOCKET_IO_PORT=5000

# Optional: Geolocation simulation for testing
USE_SIMULATED_GPS=false
SIMULATED_GPS_UPDATE_INTERVAL=5000
